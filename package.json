{
  "name": "@stianlarsen/border-beam",
  "version": "1.0.11",
  "description": "An animated border component that creates a visually stunning beam of light traveling along the borders of any container. Perfect for adding a modern, dynamic touch to your web components.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./css": "./dist/css/borderBeam.css"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Stianlars1/borderBeam.git"
  },
  "keywords": [
    "react",
    "typescript",
    "scss",
    "animation",
    "border",
    "light",
    "beam",
    "ui",
    "component"
  ],
  "author": "Stian Larsen <stian.larsen@mac.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Stianlars1/borderBeam/issues"
  },
  "homepage": "https://github.com/Stianlars1/borderBeam#readme",
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0 || ^19.0.0",
    "@types/react-dom": "^18.2.0 || ^19.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "shx": "^0.3.4",
    "tsup": "^8.0.0",
    "typescript": "^5.5.4"
  }
}
