{
  "name": "@stianlarsen/border-beam",
  "version": "1.0.11",
  "description": "An animated border component that creates a visually stunning beam of light traveling along the borders of any container. Perfect for adding a modern, dynamic touch to your web components.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && cp src/components/BorderBeam/borderBeam.css dist/styles.css",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Stianlars1/borderBeam.git"
  },
  "keywords": [
    "react",
    "typescript",
    "animation",
    "border",
    "light",
    "beam",
    "ui",
    "component",
    "next.js",
    "rsc",
    "use-client"
  ],
  "author": "Stian Larsen <stian.larsen@mac.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Stianlars1/borderBeam/issues"
  },
  "homepage": "https://github.com/Stianlars1/borderBeam#readme",
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.4"
  }
}
